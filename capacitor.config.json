{
  "appId": "com.solucnet.admin",
  "appName": "SolucNet Admin",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#28a745",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 2000, "backgroundColor": "#28a745", "showSpinner": true, "spinnerColor": "#ffffff" },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] },
    "Keyboard": { "resize": "native" }
  }
}
